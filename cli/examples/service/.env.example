# Environment layer for `service` — keys carry the derived prefix
# (root command "service" -> SERVICE_) because these ARE environment
# variables; cli never rewrites them.
#
# Load via your orchestrator (docker-compose `env_file:`, Kubernetes env),
# or in a shell:
#
#   env $(grep -v '^#' .env.example | xargs) go run ./service rest
#
SERVICE_LOG_LEVEL=debug
SERVICE_HTTP_ADDR=:7070

# Secrets: point the *_FILE variant at a mounted secret file instead of
# inlining the value. Setting both the plain var and _FILE is an error.
# SERVICE_API_KEY_FILE=/run/secrets/api_key
